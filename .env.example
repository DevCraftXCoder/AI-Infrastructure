# AI Infrastructure — secrets for local dev (.dev.vars)
# Copy to .dev.vars and fill in values. Never commit .dev.vars.

# Required
GATEWAY_KEY=your-bearer-token-here
OPENROUTER_API_KEY=sk-or-...

# Optional
PERSPECTIVE_API_KEY=

# Set via wrangler.toml [vars] — do not set here:
# FALLBACK_MODEL, OPENROUTER_BASE_URL, HTTP_REFERER, X_TITLE
